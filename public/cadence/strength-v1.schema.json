{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavio.co/cadence/strength-v1.schema.json",
  "title": "Cadence strength workout, version 1",
  "description": "A strength workout as Cadence stores it on intervals.icu: planned, in a comment in the event's description (#/$defs/plan); done, in the activity's CadenceStrength field (#/$defs/done). This root accepts either; to write or check one kind, use its definition. Weights are kilograms, times seconds, distances metres. Within version 1 new keys and set types may be added; a reader keeps what it doesn't know, and a writer writes only what this schema lists. Spec: https://wavio.co/cadence/strength-format/",
  "examples": [
    {
      "cadence": "strength",
      "v": 1,
      "exercises": [
        {
          "exercise": {
            "id": "trap-bar-deadlift",
            "name": "Deadlift (Trap Bar)"
          },
          "measure": "weight_reps",
          "rest": 150,
          "note": "Bar close to the legs.",
          "sets": [
            {
              "type": "warmup",
              "reps": 8,
              "kg": 40
            },
            {
              "reps": 5,
              "kg": 60
            },
            {
              "reps": 5,
              "kg": 60
            },
            {
              "reps": 5,
              "kg": 60
            }
          ]
        },
        {
          "exercise": {
            "id": "benchpress-dumbbells",
            "name": "Bench Press (Dumbbell)"
          },
          "measure": "weight_reps",
          "implements": 2,
          "rep_range": true,
          "rest": 90,
          "superset": "A",
          "sets": [
            {
              "reps": 8,
              "reps_max": 10,
              "kg": 20
            },
            {
              "reps": 8,
              "reps_max": 10,
              "kg": 20
            }
          ]
        },
        {
          "exercise": {
            "id": "pull-ups-on-machine",
            "name": "Assisted Pull-Up (Machine)"
          },
          "measure": "assisted_reps",
          "superset": "A",
          "sets": [
            {
              "reps": 6,
              "kg": 28
            },
            {
              "reps": 6,
              "kg": 28
            }
          ]
        }
      ]
    },
    {
      "cadence": "strength",
      "v": 1,
      "bodyweight": 69.9,
      "started_at": "2026-11-17T18:02:11Z",
      "exercises": [
        {
          "exercise": {
            "id": "trap-bar-deadlift",
            "name": "Deadlift (Trap Bar)"
          },
          "measure": "weight_reps",
          "note": "Grip slipped on the last set.",
          "sets": [
            {
              "type": "warmup",
              "reps": 8,
              "kg": 40,
              "done_at": 95,
              "rest_end_at": 180
            },
            {
              "reps": 5,
              "kg": 60,
              "done_at": 262,
              "rest_end_at": 412
            },
            {
              "reps": 5,
              "kg": 60,
              "done_at": 480,
              "rest_end_at": 630
            },
            {
              "reps": 4,
              "kg": 60,
              "done_at": 701
            }
          ]
        },
        {
          "exercise": {
            "id": "pull-ups-on-machine",
            "name": "Assisted Pull-Up (Machine)"
          },
          "measure": "assisted_reps",
          "sets": [
            {
              "reps": 6,
              "kg": 28,
              "done_at": 840,
              "rest_end_at": 930
            },
            {
              "reps": 6,
              "kg": 28,
              "done_at": 1004
            }
          ]
        }
      ]
    }
  ],
  "anyOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/done"
    }
  ],
  "$defs": {
    "plan": {
      "title": "A planned workout",
      "description": "What the comment in an event's description holds: the exercises to do, with their rests, rep ranges and notes. It has none of the done sets' keys",
      "type": "object",
      "required": [
        "cadence",
        "v",
        "exercises"
      ],
      "properties": {
        "cadence": {
          "$ref": "#/$defs/cadence"
        },
        "v": {
          "$ref": "#/$defs/v"
        },
        "exercises": {
          "type": "array",
          "description": "The exercises in the order they are done",
          "items": {
            "$ref": "#/$defs/plannedExercise"
          }
        },
        "bodyweight": false,
        "started_at": false
      }
    },
    "done": {
      "title": "Done sets",
      "description": "What an activity's CadenceStrength field holds: the sets that were done, and for a session logged live, when. It has none of a plan's rests or rep ranges",
      "type": "object",
      "required": [
        "cadence",
        "v",
        "exercises"
      ],
      "properties": {
        "cadence": {
          "$ref": "#/$defs/cadence"
        },
        "v": {
          "$ref": "#/$defs/v"
        },
        "exercises": {
          "type": "array",
          "description": "The exercises that had a set done, in the order they were done",
          "items": {
            "$ref": "#/$defs/doneExercise"
          }
        },
        "bodyweight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The athlete's weight in kilograms that Weight lifted counted bodyweight sets with. Left out when no bodyweight set counted",
          "maximum": 1000
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "Logged live only: when the session started, ISO 8601 in UTC",
          "examples": [
            "2026-11-17T18:02:11Z"
          ]
        }
      }
    },
    "cadence": {
      "const": "strength",
      "description": "Marks the JSON as Cadence's strength format"
    },
    "v": {
      "const": 1,
      "description": "The format's version. Cadence reads version 1 only"
    },
    "plannedExercise": {
      "description": "An exercise of a plan",
      "$ref": "#/$defs/exercise",
      "type": "object",
      "required": [
        "sets"
      ],
      "properties": {
        "rep_range": {
          "type": "boolean",
          "description": "The reps are a range, reps to reps_max. Left out when false"
        },
        "rest": {
          "type": "integer",
          "minimum": 0,
          "description": "Seconds of rest after each set. In a superset, after each round",
          "maximum": 86400
        },
        "sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plannedSet"
          }
        }
      }
    },
    "doneExercise": {
      "description": "An exercise as done",
      "$ref": "#/$defs/exercise",
      "type": "object",
      "required": [
        "sets"
      ],
      "properties": {
        "rep_range": false,
        "rest": false,
        "sets": {
          "type": "array",
          "description": "The sets that were done",
          "items": {
            "$ref": "#/$defs/doneSet"
          }
        }
      }
    },
    "exercise": {
      "description": "What a planned exercise and a done one share",
      "type": "object",
      "required": [
        "exercise",
        "measure"
      ],
      "properties": {
        "exercise": {
          "type": "object",
          "description": "Which exercise: its id in Cadence's library (https://wavio.co/cadence/exercises.json) and its name. An id Cadence doesn't know shows by its name",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "examples": [
                "trap-bar-deadlift",
                "barbell-bench-press"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "examples": [
                "Deadlift (Trap Bar)"
              ]
            }
          }
        },
        "measure": {
          "type": "string",
          "description": "What a set records. Take it from the library's exercise",
          "enum": [
            "weight_reps",
            "assisted_reps",
            "weighted_reps",
            "reps",
            "time",
            "weight_time",
            "distance_time",
            "weight_distance"
          ]
        },
        "per_side": {
          "type": "boolean",
          "description": "Each side is counted on its own: 8 reps is 8 a side. Left out when false"
        },
        "implements": {
          "type": "integer",
          "minimum": 1,
          "description": "2 when two dumbbells, kettlebells or cable stacks are used at once; a set's kg is then one of them. Left out when 1",
          "maximum": 10
        },
        "superset": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "A",
            "B"
          ],
          "description": "A superset's letter, from A. Exercises next to each other with the same letter are done in turn, one set of each per round"
        },
        "note": {
          "type": "string",
          "description": "Shown under the exercise. In a plan, a note for the athlete; in done sets, what the athlete wrote while logging"
        }
      }
    },
    "plannedSet": {
      "description": "A set to do",
      "$ref": "#/$defs/set",
      "type": "object",
      "properties": {
        "reps_max": {
          "type": "integer",
          "minimum": 0,
          "description": "The top of a rep range; reps is the bottom",
          "maximum": 10000
        },
        "done_at": false,
        "rest_end_at": false
      }
    },
    "doneSet": {
      "description": "A set as done",
      "$ref": "#/$defs/set",
      "type": "object",
      "properties": {
        "reps_max": false,
        "done_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "description": "Logged live only: seconds from started_at when the set was ticked"
        },
        "rest_end_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "description": "Logged live only: seconds from started_at when the rest after the set ended (its timer, Skip or the next set); left out when no rest ran"
        }
      }
    },
    "set": {
      "type": "object",
      "description": "One set. Which numbers it has follows the exercise's measure; a working set leaves type out",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "warmup",
            "drop",
            "failure"
          ],
          "description": "What kind of set; left out for a normal working set. warmup: a warm-up, not counted with the working sets. drop: a drop set, the weight dropped and done straight after the set before, without rest. failure: a set taken to failure. Drop sets and sets to failure are working sets. Write only the types listed here. Readers treat a type they don't know as a working set and keep it, so more types can be added within version 1"
        },
        "reps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "meters": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "kg": {
          "type": "number",
          "minimum": 0,
          "description": "Always positive. The measure says whether it is lifted (weight_*), added to the body (weighted_reps) or taken off it (assisted_reps)",
          "maximum": 10000
        }
      }
    }
  }
}
